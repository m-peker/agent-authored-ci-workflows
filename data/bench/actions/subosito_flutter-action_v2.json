{"action": "subosito/flutter-action", "ref": "v2", "exists": true, "name": "Set up Flutter", "description": "Setup your runner with Flutter environment", "inputs": {"channel": {"required": false, "default": "stable", "description": "The Flutter build release channel"}, "flutter-version": {"required": false, "default": "", "description": "The Flutter version to make available on the path"}, "flutter-version-file": {"required": false, "default": "", "description": "The pubspec.yaml or FVM config file with exact Flutter version defined"}, "architecture": {"required": false, "default": "${{ runner.arch }}", "description": "The architecture of Flutter SDK executable (x64 or arm64)"}, "cache": {"required": false, "default": "false", "description": "Cache the Flutter SDK"}, "cache-key": {"required": false, "default": "", "description": "Identifier for the Flutter SDK cache"}, "cache-path": {"required": false, "default": "", "description": "Flutter SDK cache path"}, "pub-cache": {"required": false, "default": "", "description": "Cache the Dart pub dependencies"}, "pub-cache-key": {"required": false, "default": "", "description": "Identifier for the Dart .pub-cache cache"}, "pub-cache-path": {"required": false, "default": "default", "description": "Flutter pub cache path"}, "dry-run": {"required": false, "default": "false", "description": "If true, get outputs but do not install Flutter"}, "git-source": {"required": false, "default": "https://github.com/flutter/flutter.git", "description": "Git clone source"}}, "outputs": ["ARCHITECTURE", "CACHE-HIT", "CACHE-KEY", "CACHE-PATH", "CHANNEL", "GIT_SOURCE", "PUB-CACHE-HIT", "PUB-CACHE-KEY", "PUB-CACHE-PATH", "VERSION"]}